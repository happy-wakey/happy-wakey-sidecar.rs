# GENERATED from Dockerfile (sha256:ea51563076462d2f) by ores-gha-workflows/scripts/render-dkf.mjs — target linux/amd64. Do not edit; edit Dockerfile and re-render.
FROM --platform=linux/amd64 rust:1.88.0-bookworm AS build
ARG TARGETARCH
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY generated/rust ./generated/rust
RUN cargo build --release --locked --bin happy-wakey-sidecar

FROM --platform=linux/amd64 debian:bookworm-slim
RUN useradd --system --uid 65532 --no-create-home --shell /usr/sbin/nologin sidecar
COPY --from=build /src/target/release/happy-wakey-sidecar /usr/local/bin/happy-wakey-sidecar
USER 65532:65532
EXPOSE 9090
ENTRYPOINT ["/usr/local/bin/happy-wakey-sidecar"]
